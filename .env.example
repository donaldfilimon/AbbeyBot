# AbbeyBot / AbbeyServer environment (copy to .env locally — never commit secrets)

# Discord (desktop Keychain or server env)
DISCORD_BOT_TOKEN=
DISCORD_DEV_GUILD_ID=

# AbbeyServer HTTP + Postgres (production) or sqlite://memory (local smoke without Docker).
# Scripts/run-abbey.sh ignores DATABASE_URL by default (CLI uses ~/.abbey/abbey.sqlite).
# To share this URL with the CLI: ABBEY_CLI_USE_SERVER_DATABASE=1 bash Scripts/run-abbey.sh
DATABASE_URL=postgres://abbey:abbey@localhost:5432/abbeybot
# DATABASE_URL=sqlite://memory
# Local-safe default. Set 0.0.0.0 only behind HTTPS.
HTTP_HOSTNAME=127.0.0.1
HTTP_PORT=8080

# Required for the operator root and every operator/state/sync/ingest/catalog /api route.
# The server returns 503 when this is absent/blank; callers use Bearer or X-Abbey-Token.
# Health/static routes and provider-signed native webhooks use their separate policies.
# ABBEY_API_TOKEN=

# Optional desktop → AbbeyServer best-effort sync (Settings also stores these).
# Plain HTTP is accepted only for localhost/127.0.0.1/::1; remote servers require HTTPS.
# ABBEY_SYNC_SERVER_URL=http://127.0.0.1:8080
# ABBEY_SYNC_API_TOKEN=

# Optional AbbeyCore knobs (also used by desktop UserDefaults when set before launch)
# ABBEY_OPERATING_MODE=liveDiscord
# ABBEY_INFERENCE_MODE=deterministicFloor
# ABBEY_REMOTE_ENDPOINT=
# ABBEY_REPLY_COOLDOWN_SECONDS=8
# ABBEY_MEMORY_CONSOLIDATION_INTERVAL_MIN=15
# ABBEY_REPUTATION_DECAY=0.95

# Dry-run: skip Discord / Twitch gateway connect (logs dry-run: would connect).
# ABBEY_DRY_RUN=1

# Optional Twitch IRC + chat→ingest. Empty token skips connect.
# TWITCH_OAUTH_TOKEN=
# TWITCH_BOT_LOGIN=
# TWITCH_CHANNEL=

# Optional EventSub webhook secret — verifies Twitch-Eventsub-Message-Signature on
# POST /api/twitch/eventsub (HMAC-SHA256). Configure it before accepting public callbacks.
# TWITCH_EVENTSUB_SECRET=

# Optional Twitch Helix app credentials (Client Credentials Grant) for TwitchHelixClient,
# used to create EventSub subscriptions.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# Public HTTPS URL Twitch should POST EventSub deliveries to (must match a route this server
# actually serves, e.g. https://your-host/api/twitch/eventsub).
# TWITCH_EVENTSUB_CALLBACK_URL=

# Multi-social webhooks (claim-honest parsers → ingest) require ABBEY_API_TOKEN.
# POST /api/social/{youtube|x|bluesky|mastodon}/webhook
# GET  /api/social/catalog  |  /api/social/catalog/markdown
# YOUTUBE_API_KEY=
# X_BEARER_TOKEN=
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=
# MASTODON_INSTANCE=
# MASTODON_ACCESS_TOKEN=

# Opt-in EventSub auto-subscribe at server boot (chat + stream lifecycle + follow/sub/cheer). Requires ALL of:
# TWITCH_CLIENT_ID, TWITCH_CLIENT_SECRET, TWITCH_EVENTSUB_SECRET, TWITCH_EVENTSUB_CALLBACK_URL
# (https:// only), TWITCH_BROADCASTER_USER_ID, TWITCH_BOT_USER_ID, and the explicit confirmation
# below. Before confirming, authorize user:read:chat + user:bot for the bot,
# moderator:read:followers + channel:read:subscriptions + bits:read for the broadcaster, and
# either channel:bot for the broadcaster or moderator status for the bot. Anything missing → warn+skip.
# Claim-honest: unverified against live Twitch (handshake needs a public HTTPS callback).
# ABBEY_TWITCH_EVENTSUB_AUTO_SUBSCRIBE=0
# TWITCH_BROADCASTER_USER_ID=
# TWITCH_BOT_USER_ID=
# TWITCH_EVENTSUB_AUTHORIZATION_CONFIRMED=0

# Industry prompt overlay only (general|healthcare|finance|legal) — not compliance certs.
# ABBEY_INDUSTRY_PROFILE=general

# Must stay off — no blockchain node in this package.
# ABBEY_DECENTRALIZATION_ENABLED=0

# Launch toolchain for Scripts/run-server.sh / run-abbey.sh (desktop always Xcode):
# ABBEY_SWIFT=xcode     # default — /usr/bin/xcrun --toolchain default
# ABBEY_SWIFT=swiftly   # PATH ~/.swiftly/bin/swift (server/CLI only; not AbbeyBot GUI)
