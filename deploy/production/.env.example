# Copy to .env, chmod 600, and replace every REQUIRED value. Never commit .env.

# Release workflow output. A mutable tag is rejected by deploy.sh.
ABBEYBOT_IMAGE=ghcr.io/donaldfilimon/abbeybot@sha256:REQUIRED_64_HEX_DIGEST
ABBEY_CADDY_IMAGE=ghcr.io/donaldfilimon/abbeybot-caddy@sha256:REQUIRED_64_HEX_DIGEST

# Generate new independent values, for example: openssl rand -hex 32
POSTGRES_PASSWORD=REQUIRED_FRESH_URL_SAFE_PASSWORD
ABBEY_API_TOKEN=REQUIRED_OPERATOR_TOKEN
ABBEY_QUASAR_API_TOKEN=REQUIRED_QUASAR_OPERATOR_TOKEN
ABBEY_QUASAR_PREVIEW_INTERNAL_TOKEN=REQUIRED_CADDY_SERVICE_TOKEN

ABBEY_API_DOMAIN=api.xfoss.dev
ABBEY_QUASAR_PREVIEW_DOMAIN=preview.xfoss.dev
ABBEY_QUASAR_ALLOWED_ORIGINS=
ACME_EMAIL=REQUIRED_ACME_EMAIL

# This token belongs only to Caddy. Scope it to DNS edit on the one zone.
CLOUDFLARE_API_TOKEN=REQUIRED_SCOPED_DNS_TOKEN

ABBEY_INFERENCE_MODE=remoteCompatible
ABBEY_REMOTE_ENDPOINT=https://api.openai.com/v1/chat/completions
ABBEY_REMOTE_MODEL=gpt-5.4-mini
ABBEY_REMOTE_API_TOKEN=

# Keep dry-run enabled until live Discord policy and credentials are reviewed.
ABBEY_DRY_RUN=1
ABBEY_QUIET=1
DISCORD_BOT_TOKEN=
DISCORD_DEV_GUILD_ID=
DISCORD_OPERATOR_USER_IDS=
ABBEY_QUASAR_GUILD_IDS=
ABBEY_QUASAR_GUILD_BUDGET=0
