# Copy to .backup.env and chmod 600. Literal KEY=value only; do not source it.
# Pre-create a private bucket. Use an R2 Object Read & Write key scoped ONLY to it.
# Separate from Caddy's DNS token and the application's model/API credentials.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET/abbeybot
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Absolute path to an independent password file (chmod 600), stored outside this repo.
# Keep a protected copy of the password and R2 recovery credentials off this host.
RESTIC_PASSWORD_FILE=
