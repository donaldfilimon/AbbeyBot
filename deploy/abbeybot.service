[Unit]
Description=AbbeyServer Discord bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=abbeybot
WorkingDirectory=/opt/abbeybot
EnvironmentFile=/opt/abbeybot/.env
ExecStart=/opt/abbeybot/AbbeyBot serve --hostname ${HTTP_HOSTNAME:-0.0.0.0} --port ${HTTP_PORT:-8080}
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
