# AbbeyBot / AbbeyServer environment (copy to .env locally — never commit secrets)

# Discord (desktop Keychain or server env)
DISCORD_BOT_TOKEN=
DISCORD_DEV_GUILD_ID=

# AbbeyServer HTTP + Postgres (production) or sqlite://memory (local smoke without Docker).
# Scripts/run-abbey.sh ignores DATABASE_URL by default (CLI uses ~/.abbey/abbey.sqlite).
# To share this URL with the CLI: ABBEY_CLI_USE_SERVER_DATABASE=1 bash Scripts/run-abbey.sh
DATABASE_URL=postgres://abbey:abbey@localhost:5432/abbeybot
# DATABASE_URL=sqlite://memory
HTTP_HOSTNAME=0.0.0.0
HTTP_PORT=8080

# Optional: gate POST /api/ingest, POST /api/state/*, and list GETs
# (/api/users|channels|messages|reputation|interactions|equity) when set (Bearer or X-Abbey-Token).
# Leave empty for local smoke.
# ABBEY_API_TOKEN=

# Optional desktop → AbbeyServer best-effort sync (Settings also stores these)
# ABBEY_SYNC_SERVER_URL=http://127.0.0.1:8080
# ABBEY_SYNC_API_TOKEN=

# Optional AbbeyCore knobs (also used by desktop UserDefaults when set before launch)
# ABBEY_OPERATING_MODE=liveDiscord
# ABBEY_INFERENCE_MODE=deterministicFloor
# ABBEY_REMOTE_ENDPOINT=
# ABBEY_REPLY_COOLDOWN_SECONDS=8
# ABBEY_MEMORY_CONSOLIDATION_INTERVAL_MIN=15
# ABBEY_REPUTATION_DECAY=0.95

# Dry-run: skip Discord / Twitch gateway connect (logs dry-run: would connect).
# ABBEY_DRY_RUN=1

# Optional Twitch IRC + chat→ingest (no EventSub). Empty token skips connect.
# TWITCH_OAUTH_TOKEN=
# TWITCH_BOT_LOGIN=
# TWITCH_CHANNEL=

# Industry prompt overlay only (general|healthcare|finance|legal) — not compliance certs.
# ABBEY_INDUSTRY_PROFILE=general

# Must stay off — no blockchain node in this package.
# ABBEY_DECENTRALIZATION_ENABLED=0

# Launch toolchain for Scripts/run-server.sh / run-abbey.sh (desktop always Xcode):
# ABBEY_SWIFT=xcode     # default — /usr/bin/xcrun --toolchain default
# ABBEY_SWIFT=swiftly   # PATH ~/.swiftly/bin/swift (server/CLI only; not AbbeyBot GUI)
