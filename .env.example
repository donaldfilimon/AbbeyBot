# AbbeyBot / AbbeyServer environment (copy to .env locally — never commit secrets)

# Discord (desktop Keychain or server env)
DISCORD_BOT_TOKEN=
DISCORD_DEV_GUILD_ID=

# AbbeyServer HTTP + Postgres (production) or sqlite://memory (local smoke without Docker)
DATABASE_URL=postgres://abbey:abbey@localhost:5432/abbeybot
# DATABASE_URL=sqlite://memory
HTTP_HOSTNAME=0.0.0.0
HTTP_PORT=8080

# Optional AbbeyCore knobs (also used by desktop UserDefaults when set before launch)
# ABBEY_OPERATING_MODE=liveDiscord
# ABBEY_INFERENCE_MODE=deterministicFloor
# ABBEY_REMOTE_ENDPOINT=
# ABBEY_REPLY_COOLDOWN_SECONDS=8
# ABBEY_MEMORY_CONSOLIDATION_INTERVAL_MIN=15
# ABBEY_REPUTATION_DECAY=0.95
